# Next.js and typical JS project ignore rules

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# build outputs
/.next/
/out/
/build
/dist

# production and cache
.DS_Store
*.pem
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Yarn v2/v3
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
